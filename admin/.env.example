# Copy to admin/.env.local. Populate only from THIS project's running Supabase.
# Local URL is normally http://127.0.0.1:54321 after Supabase starts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT is supported in the field above; VITE_SUPABASE_ANON_KEY is an alias.
# Never add service_role / sb_secret_ keys, passwords or access tokens to VITE_*.
